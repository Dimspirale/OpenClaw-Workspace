python - <<'PY'
import builtins, os, traceback, sys
# sauvegardes
_orig_open = builtins.open
_orig_os_open = os.open

def _dump_stack_and_continue(path, *a, **kw):
    try:
        s = str(path)
    except Exception:
        s = "<non-string>"
    if "/etc/apt" in s:
        print("=== PYTHON OPEN ATTEMPT ===", file=sys.stderr)
        print("Path:", s, file=sys.stderr)
        traceback.print_stack(file=sys.stderr)
        print("=== END STACK ===", file=sys.stderr)
    # call original (may raise)
    return None

def open_with_stack(path, *a, **kw):
    _dump_stack_and_continue(path, *a, **kw)
    return _orig_open(path, *a, **kw)

def os_open_with_stack(path, *a, **kw):
    _dump_stack_and_continue(path, *a, **kw)
    return _orig_os_open(path, *a, **kw)

builtins.open = open_with_stack
os.open = os_open_with_stack

# importer les modules suspects (essayer plusieurs variantes)
candidates = [
    "googleapiclient",
    "googleapiclient.discovery_cache",
    "googleapiclient.discovery_cache.documents",
]

for name in candidates:
    try:
        __import__(name)
        print("import", name, "OK", file=sys.stderr)
    except Exception as e:
        print("import", name, "error:", repr(e), file=sys.stderr)
