#!/usr/bin/env bash

# Hermès HUD Ω v16 — MODE SIMULATION
# Cockpit-grade, dynamique, vivant, indépendant des métriques WSL

C_RESET="\033[0m"
C_G="\033[32m"
C_Y="\033[33m"
C_R="\033[31m"
C_B="\033[34m"
C_C="\033[36m"
C_M="\033[35m"
C_S="\033[90m"

bargraph() {
    local val=$1
    local max_seg=20
    local bars=$(( val * max_seg / 100 ))
    local out=""
    for ((i=1; i<=max_seg; i++)); do
        if [ $i -le $bars ]; then out+="#"; else out+="-"; fi
    done
    echo "$out"
}

sim_value() {
    local base=$1
    local amp=$2
    local t=$(date +%s)
    local mod=$(( (t % 10) - 5 ))
    local v=$(( base + mod * amp / 5 ))
    if [ $v -lt 0 ]; then v=0; fi
    if [ $v -gt 100 ]; then v=100; fi
    echo $v
}

sim_net() {
    local t=$(date +%s)
    echo $(( (t % 6) * 120 ))
}

