perl -0777 -pe '
  s{
    \#\s*write_atomic_if_changed[^\n]*\n
    write_atomic_if_changed\(\)[^\}]*\}
  }{
    # write_atomic_if_changed VALUE
    # Ecrit "epoch value" dans le fichier runtime uniquement si la valeur a changé.
    write_atomic_if_changed() {
      OUTFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hermes_net"
      LOCK="/tmp/hermes_net.lock"
      NEW_VAL="$1"
      # lire l'ancienne ligne sans CR/LF
      OLD_LINE=$(tr -d "\r\n" < "$OUTFILE" 2>/dev/null || echo "")
      # extraire l'ancienne valeur (deuxième champ) si présente
      OLD_VAL=$(printf "%s" "$OLD_LINE" | awk "{print \$2}" 2>/dev/null || echo "")
      # si la valeur a changé, écrire "epoch value"
      if [ "$OLD_VAL" != "$NEW_VAL" ]; then         TS=$(date +%s);         NEW="${TS} ${NEW_VAL}";         (           flock -n 9 || exit 0;           printf "%s\n" "$NEW" > "$OUTFILE";         ) 9>"$LOCK";       fi
    }
  }gsx' -i ~/.local/bin/hermes_net_daemon.sh

