#!/usr/bin/env bash

# Hermès HUD Ω v16 — MODE SIMULATION
# Cockpit-grade, dynamique, vivant, indépendant des métriques WSL

C_RESET="\033[0m"
C_G="\033[32m"
C_Y="\033[33m"
C_R="\033[31m"
C_B="\033[34m"
C_C="\033[36m"
C_M="\033[35m"
C_S="\033[90m"

bargraph() {
    local val=$1
    local max_seg=20
    local bars=$(( val * max_seg / 100 ))
    local out=""
    for ((i=1; i<=max_seg; i++)); do
        if [ $i -le $bars ]; then out+="#"; else out+="-"; fi
    done
    echo "$out"
}

sim_value() {
    local base=$1
    local amp=$2
    local t=$(date +%s)
    local mod=$(( (t % 10) - 5 ))
    local v=$(( base + mod * amp / 5 ))
    if [ $v -lt 0 ]; then v=0; fi
    if [ $v -gt 100 ]; then v=100; fi
    echo $v
}

sim_net() {
    local t=$(date +%s)
    echo $(( (t % 6) * 120 ))
}

sim_vram() {
    local t=$(date +%s)
    echo $(( 200 + (t % 40) * 5 ))
}

hermes_mode() {
    local p=$1
    if   [ $p -gt 90 ]; then echo "CRITICAL"
    elif [ $p -gt 75 ]; then echo "OVERDRIVE"
    elif [ $p -gt 60 ]; then echo "ALERT"
    elif [ $p -lt 20 ]; then echo "STEALTH"
    else echo "NORMAL"; fi
}

nebula_color() {
    case $1 in
        STEALTH)   echo -n "$C_S" ;;
        NORMAL)    echo -n "$C_C" ;;
        ALERT)     echo -n "$C_Y" ;;
        OVERDRIVE) echo -n "$C_M" ;;
        CRITICAL)  echo -n "$C_R" ;;
    esac
}

hud_minimal() {

    CPU=$(sim_value 30 25)
    RAM=$(sim_value 40 20)
    GPU=$(sim_value 10 15)
    VRAM=$(sim_vram)
    NET=$(sim_net)

    PRED=$(( (CPU + RAM + GPU) / 3 ))
    MODE=$(hermes_mode $PRED)

    CPU_BAR=$(bargraph $CPU)
    RAM_BAR=$(bargraph $RAM)
    GPU_BAR=$(bargraph $GPU)

    COLOR=$(nebula_color $MODE)

    if [ $PRED -lt 25 ]; then
        echo -n "${COLOR}CPU:${CPU}% RAM:${RAM}% GPU:${GPU}% NET:${NET}KB/s${C_RESET}"
        return
    fi

    if [ $PRED -lt 60 ]; then
        echo -n "${COLOR}CPU:${CPU}%[$CPU_BAR] RAM:${RAM}%[$RAM_BAR] GPU:${GPU}%[$GPU_BAR] NET:${NET}KB/s${C_RESET}"
        return
    fi

    if [ $PRED -lt 85 ]; then
        echo -n "${COLOR}CPU:${CPU}%[$CPU_BAR] RAM:${RAM}%[$RAM_BAR] GPU:${GPU}%[$GPU_BAR] VRAM:${VRAM}MB NET:${NET}KB/s${C_RESET}"
        return
    fi

    echo -n "${COLOR}MODE:${MODE} CPU:${CPU}%[$CPU_BAR] RAM:${RAM}%[$RAM_BAR] GPU:${GPU}%[$GPU_BAR] VRAM:${VRAM}MB NET:${NET}KB/s${C_RESET}"
}
EOF

