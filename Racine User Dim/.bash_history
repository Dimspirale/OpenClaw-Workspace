wget -q -O /dev/null http://speedtest.tele2.net/1MB.zip & sleep 2; cat /tmp/hermes_net
cat /tmp/hermes_net || echo "absent"
watch -n 1 'cat /tmp/hermes_net 2>/dev/null || echo "absent"
mkdir -p ~/.local/bin
cat > ~/.local/bin/hermes_net_daemon.sh <<'EOF'
#!/usr/bin/env bash
OUTDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
OUTFILE="$OUTDIR/hermes_net"
while true; do
  IFACE=$(ip route get 8.8.8.8 2>/dev/null \
    | awk '/dev/ {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' \
    | head -1)
  if [ -n "$IFACE" ] && [ -r /proc/net/dev ]; then
    RX1=$(awk -v iface="$IFACE:" '$1==iface {print $2}' /proc/net/dev 2>/dev/null)
    TX1=$(awk -v iface="$IFACE:" '$1==iface {print $10}' /proc/net/dev 2>/dev/null)
    sleep 1
    RX2=$(awk -v iface="$IFACE:" '$1==iface {print $2}' /proc/net/dev 2>/dev/null)
    TX2=$(awk -v iface="$IFACE:" '$1==iface {print $10}' /proc/net/dev 2>/dev/null)
    if [ -n "$RX1" ] && [ -n "$RX2" ] && [ "$RX2" -ge "$RX1" ] && \
       [ -n "$TX1" ] && [ -n "$TX2" ] && [ "$TX2" -ge "$TX1" ]; then
      BPS=$(( (RX2 - RX1) + (TX2 - TX1) ))   # octets/s
      KBPS=$(( (BPS + 512) / 1024 ))        # arrondi KB/s
      printf "%d" "$KBPS" > "$OUTFILE"
    else
      printf "0" > "$OUTFILE"
    fi
  else
    printf "DOWN" > "$OUTFILE"
  fi
  sleep 1   # pause courte pour meilleure réactivité
done
EOF

chmod +x ~/.local/bin/hermes_net_daemon.sh
systemctl --user daemon-reload
systemctl --user restart hermes-net.service
systemctl --user status hermes-net.service --no-pager
systemctl --user status hermes-net.service --no-pager > ~/hermes-net.status 2>&1
journalctl --user -u hermes-net.service -n 200 --no-pager > ~/hermes-net.log 2>&1
journalctl --user -u hermes-net.service -f
OUT=~/hermes-net.$(date +%Y%m%d-%H%M%S).log
{   echo "=== systemctl --user status hermes-net.service ===";   systemctl --user status hermes-net.service --no-pager;   echo;   echo "=== journalctl --user -u hermes-net.service (last 200 lines) ===";   journalctl --user -u hermes-net.service -n 200 --no-pager; } > "$OUT" 2>&1
echo "Saved to $OUT"
less ~/hermes-net.20260508-223900.log
OUT=~/hermes-net.$(date +%Y%m%d-%H%M%S).log.gz
{   echo "=== systemctl --user status hermes-net.service ===";   systemctl --user status hermes-net.service --no-pager;   echo;   echo "=== journalctl --user -u hermes-net.service (last 200 lines) ===";   journalctl --user -u hermes-net.service -n 200 --no-pager; } | gzip > "$OUT"
echo "Saved compressed to $OUT"
mkdir -p ~/.config/systemd/user
cat > ~/.config/systemd/user/hermes-net.service <<'EOF'
[Unit]
Description=Hermes network throughput daemon
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hermes_net_daemon.sh
Restart=always
RestartSec=5
StandardOutput=append:%h/hermes-net.log
StandardError=append:%h/hermes-net.err

[Install]
WantedBy=default.target
EOF

