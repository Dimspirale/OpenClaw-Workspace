# 2) remplacer la définition entière de la fonction write_atomic_if_changed
perl -0777 -pe '
  s{
    \#\s*write_atomic_if_changed[^\n]*\n      # header comment line
    write_atomic_if_changed\(\)[^\}]*\}
  }{
    # write_atomic_if_changed VALUE
    # Ecrit "epoch value" dans le fichier runtime si la valeur a changé.
    # Si TIMESTAMP est absent, on utilise epoch actuel.
    write_atomic_if_changed() {
      OUTFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hermes_net"
      LOCK="/tmp/hermes_net.lock"
      NEW_VAL="$1"
      TS="${2:-$(date +%s)}"
      NEW="${TS} ${NEW_VAL}"
      # lire l'ancienne valeur sans CR/LF
      OLD=$(tr -d "\r\n" < "$OUTFILE" 2>/dev/null || echo "")
      if [ "$OLD" != "$NEW" ]; then         (           flock -n 9 || exit 0;           printf "%s\n" "$NEW" > "$OUTFILE";         ) 9>"$LOCK";       fi
    }
  }gsx' -i ~/.local/bin/hermes_net_daemon.sh

