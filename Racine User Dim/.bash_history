# 7. test rapide 10s : générer trafic et observer runtime
OUTFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hermes_net"
wget -q -O /dev/null http://speedtest.tele2.net/100MB.zip & WGET_PID=$!; for i in $(seq 1 10); do cat "$OUTFILE" 2>/dev/null || echo "absent"; sleep 1; done; wait $WGET_PID 2>/dev/null || true
# sauvegarde
cp ~/.local/bin/hermes_net_daemon.sh ~/.local/bin/hermes_net_daemon.sh.bak_fix
# supprimer toute ancienne définition write_if_changed si présente (pour éviter doublons)
sed -i '/^# write_if_changed/,$d' ~/.local/bin/hermes_net_daemon.sh
# ajouter la fonction write_atomic_if_changed à la fin du script
cat >> ~/.local/bin/hermes_net_daemon.sh <<'EOF'

# write_atomic_if_changed VALUE
# Ecrit VALUE dans le fichier runtime uniquement si la valeur actuelle est différente.
# Utilise flock pour éviter les écritures concurrentes et assure atomicité.
write_atomic_if_changed() {
  OUTFILE="\${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hermes_net"
  LOCK="/tmp/hermes_net.lock"
  NEW="\$1"
  OLD=\$(cat "\$OUTFILE" 2>/dev/null || echo "")
  if [ "\$OLD" != "\$NEW" ]; then
    (
      flock -n 9 || exit 0
      printf "%d\n" "\$NEW" > "\$OUTFILE"
    ) 9>"\$LOCK"
  fi
}
EOF

# remplacer toutes les écritures directes connues par write_atomic_if_changed
sed -i -E 's/printf "%d\\n" "\\$KBPS"( > "\\$OUTFILE")?/write_atomic_if_changed "\\$KBPS"/g' ~/.local/bin/hermes_net_daemon.sh
