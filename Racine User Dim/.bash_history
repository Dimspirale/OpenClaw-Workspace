# Si dos2unix est installé
if command -v dos2unix >/dev/null 2>&1; then   dos2unix ~/.local/bin/hermes_net_daemon.sh; else
  sed -i 's/\r$//' ~/.local/bin/hermes_net_daemon.sh; fi
# 3) Vérifier la première ligne (shebang) propre
head -n1 ~/.local/bin/hermes_net_daemon.sh | sed -n '1p' | cat -v
# 4) S'assurer que le shebang est correct
# La sortie doit être exactement: #!/usr/bin/env bash
# Si ce n'est pas le cas, remplacer la première ligne :
