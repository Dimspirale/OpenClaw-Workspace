mkdir -p ~/.local/bin
cat > ~/.local/bin/hermes_log_rotate.sh <<'EOF'
#!/usr/bin/env bash
LOG="$HOME/hermes-net.log"
ERR="$HOME/hermes-net.err"
MAX=10485760  # 10 MB
for F in "$LOG" "$ERR"; do
  [ -f "$F" ] || continue
  SIZE=$(stat -c%s "$F" 2>/dev/null || echo 0)
  if [ "$SIZE" -ge "$MAX" ]; then
    mv "$F" "${F}.$(date +%Y%m%d-%H%M%S)"
    : > "$F"
  fi
done
EOF

