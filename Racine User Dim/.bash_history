awk '/:/ && $1 ~ /:/ {print $1, $2}' /proc/net/dev | sed 's/://g' > /tmp/net_before
# lancer transfert 2–3s
sleep 3
awk '/:/ && $1 ~ /:/ {print $1, $2}' /proc/net/dev | sed 's/://g' > /tmp/net_after
paste /tmp/net_before /tmp/net_after
