#!/usr/bin/env bash

# Guard: require bash (works whether script is sourced or executed)
if [ -z "$BASH_VERSION" ]; then
  echo "prompt.sh requires bash. Aborting." >&2
  return 0 2>/dev/null || exit 0
fi

prompt_cockpit() {
    # Résolution correcte du chemin même via symlink
    local DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

    # Charger les modules Hermès
    source "$DIR/modules.sh"
    source "$DIR/hud.sh"
    source "$DIR/ultra.sh"

    # Générer HUD ULTRA seulement si la fonction/commande existe
    if command -v ultra_hud >/dev/null 2>&1; then
        HUD="$(ultra_hud)"
    else
        HUD=""
    fi

    # Prompt cockpit ULTRA
    PS1="\n${HUD}\n\u@\h:\w\$ "
}
EOF

