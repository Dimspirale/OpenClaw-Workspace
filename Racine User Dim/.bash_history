#    On remplace la section de génération du HUD dans prompt.sh par une version non bloquante.
cat >| ~/openclaw/cockpit/hermes/prompt.sh <<'EOF'
#!/usr/bin/env bash

# Guard: require bash (works whether script is sourced or executed)
if [ -z "$BASH_VERSION" ]; then
  echo "prompt.sh requires bash. Aborting." >&2
  return 0 2>/dev/null || exit 0
fi

# Met à jour la variable HUD de façon sûre et silencieuse
update_hermes_hud() {
    if command -v ultra_hud >/dev/null 2>&1; then
        HUD="$(ultra_hud 2>/dev/null)"
    else
        HUD=""
    fi
}

# Exécute update_hermes_hud avant chaque affichage du prompt
# Conserver d'autres éventuels handlers de PROMPT_COMMAND
if [ -z "$PROMPT_COMMAND" ]; then
    PROMPT_COMMAND='update_hermes_hud'
else
    # Préserver l'existant et ajouter la mise à jour HUD (évite d'écraser)
    PROMPT_COMMAND="update_hermes_hud; $PROMPT_COMMAND"
fi

prompt_cockpit() {
    # Résolution correcte du chemin même via symlink
    local DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

    # Charger les modules Hermès (si nécessaires)
    source "$DIR/modules.sh"
    source "$DIR/hud.sh"
    source "$DIR/ultra.sh"

    # Utiliser la variable HUD mise à jour par PROMPT_COMMAND
    PS1="\n${HUD}\n\u@\h:\w\$ "
}
EOF

