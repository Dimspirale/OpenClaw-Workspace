#!/usr/bin/env bash

# Hermès Cockpit Launcher Ω
# Appelle HUD, modules, prompt et modes

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Charger modules
source "$DIR/modules.sh"
source "$DIR/prompt.sh"
source "$DIR/hud.sh"

case "$1" in
    --hud)
        hud_minimal
        ;;
    *)
        # Mode normal : afficher prompt cockpit
        prompt_cockpit
        ;;
esac
EOF

