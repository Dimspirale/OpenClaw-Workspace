# vérifier qu'il n'y a plus d'écritures directes vers $OUTFILE
grep -nE 'printf .*\\$OUTFILE|> *"\\$OUTFILE"' ~/.local/bin/hermes_net_daemon.sh || echo "Aucune écriture directe restante"
