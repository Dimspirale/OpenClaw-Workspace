import logging, re
_orig_warning = logging.warning
_pattern = re.compile(r"could not open file '.*/etc/apt/.*'")

def _filter_warning(msg, *a, **kw):
    try:
        text = str(msg)
    except Exception:
        return _orig_warning(msg, *a, **kw)
    if _pattern.search(text):
        return  # ignorer ce warning précis
    return _orig_warning(msg, *a, **kw)

logging.warning = _filter_warning
PY

