#!/usr/bin/env bash

# Guard: require bash (works whether script is sourced or executed)
if [ -z "$BASH_VERSION" ]; then
  echo "prompt.sh requires bash. Aborting." >&2
  return 0 2>/dev/null || exit 0
fi

# Met à jour la variable HUD de façon sûre et silencieuse
update_hermes_hud() {
    if command -v ultra_hud >/dev/null 2>&1; then
        HUD="$(ultra_hud 2>/dev/null)"
    else
        HUD=""
    fi
}

# Exécute update_hermes_hud avant chaque affichage du prompt
if [ -z "$PROMPT_COMMAND" ]; then
    PROMPT_COMMAND='update_hermes_hud'
else
    PROMPT_COMMAND="update_hermes_hud; $PROMPT_COMMAND"
fi

prompt_cockpit() {
    local DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    source "$DIR/modules.sh"
    source "$DIR/hud.sh"
    source "$DIR/ultra.sh"
    PS1="\n${HUD}\n\u@\h:\w\$ "
}
EOF

